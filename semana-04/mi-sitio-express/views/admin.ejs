<!DOCTYPE html>
<html lang="es">
<head>
  <title>Admin</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container" style="margin-top: 40px;">
    <h5 class="section-title center-align">
      <i class="material-icons left">admin_panel_settings</i>Mensajes recibidos
      <span class="new badge" data-badge-caption="mensajes"><%= messages.length %></span>
    </h5>

    <% if (messages.length === 0) { %>
      <div class="card reveal">
        <div class="empty-state">
          <i class="material-icons">inbox</i>
          <p>Aún no hay mensajes. <a href="/contact">Envía uno desde el formulario de contacto</a>.</p>
        </div>
      </div>
    <% } else { %>
      <table class="striped responsive-table highlight reveal">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Mensaje</th>
          </tr>
        </thead>
        <tbody>
          <% messages.forEach(m => { %>
            <tr>
              <td><strong><%= m.nombre %></strong></td>
              <td><%= m.email %></td>
              <td><%= m.mensaje %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <div class="center-align" style="margin-top: 20px;">
      <a href="/contact" class="waves-effect waves-light btn btn-accent">
        <i class="material-icons left">add</i>Nuevo mensaje
      </a>
    </div>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
</body>
</html>
