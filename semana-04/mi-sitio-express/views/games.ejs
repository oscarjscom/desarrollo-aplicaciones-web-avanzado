<!DOCTYPE html>
<html lang="es">
<head>
  <title>Videojuegos</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container" style="margin-top: 40px;">

    <div class="game-banner reveal">
      <img
        src="https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1200&q=60"
        alt="Videojuegos"
        onerror="this.remove();">
      <h4 class="game-banner-title pixel-font" style="font-size: clamp(0.9rem, 2.5vw, 1.4rem);">
        <span class="float-icon">🕹️</span> Game Library
      </h4>
    </div>

    <h5 class="section-title center-align">
      <i class="material-icons left">sports_esports</i>Catálogo de Videojuegos
    </h5>

    <!-- Formulario para crear un nuevo registro -->
    <div class="card reveal">
      <div class="card-content">
        <span class="card-title">
          <i class="material-icons left accent-text">add_circle</i>Agregar Videojuego
        </span>

        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
          <div class="card-panel red lighten-4 red-text text-darken-4">
            <strong>Revisa lo siguiente:</strong>
            <ul style="margin: 8px 0 0; padding-left: 20px;">
              <% errors.forEach(err => { %>
                <li><%= err %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <% const old = (typeof locals.old !== 'undefined') ? locals.old : {}; %>
        <% const anioMaximo = new Date().getFullYear() + 1; %>

        <form action="/games" method="POST">
          <div class="row" style="margin-bottom: 0;">
            <div class="input-field col s12 m6">
              <i class="material-icons prefix">title</i>
              <input id="titulo" type="text" name="titulo" value="<%= old.titulo || '' %>" required minlength="2" maxlength="80">
              <label for="titulo" class="<%= old.titulo ? 'active' : '' %>">Título</label>
            </div>

            <div class="input-field col s12 m6">
              <i class="material-icons prefix">business</i>
              <input id="desarrollador" type="text" name="desarrollador" value="<%= old.desarrollador || '' %>" required minlength="2" maxlength="80">
              <label for="desarrollador" class="<%= old.desarrollador ? 'active' : '' %>">Desarrollador</label>
            </div>
          </div>

          <div class="row" style="margin-bottom: 0;">
            <div class="input-field col s12">
              <i class="material-icons prefix">image</i>
              <input id="imagen" type="url" name="imagen" value="<%= old.imagen || '' %>" placeholder="https://..." pattern="https?://.+">
              <label for="imagen" class="active">URL de la imagen (opcional)</label>
            </div>
          </div>

          <div class="row" style="margin-bottom: 0;">
            <div class="input-field col s12 m4">
              <select name="genero" id="genero" required>
                <option value="" disabled <%= !old.genero ? 'selected' : '' %>>Elige un género</option>
                <% ["Acción","Aventura","RPG","Deportes","Estrategia","Terror","Simulación"].forEach(op => { %>
                  <option value="<%= op %>" <%= old.genero === op ? 'selected' : '' %>><%= op %></option>
                <% }) %>
              </select>
              <label>Género</label>
            </div>

            <div class="input-field col s12 m4">
              <select name="plataforma" id="plataforma" required>
                <option value="" disabled <%= !old.plataforma ? 'selected' : '' %>>Elige una plataforma</option>
                <% ["PC","PlayStation","Xbox","Nintendo Switch","Móvil"].forEach(op => { %>
                  <option value="<%= op %>" <%= old.plataforma === op ? 'selected' : '' %>><%= op %></option>
                <% }) %>
              </select>
              <label>Plataforma</label>
            </div>

            <div class="input-field col s12 m4">
              <i class="material-icons prefix">event</i>
              <input id="anio" type="number" name="anio" value="<%= old.anio || '' %>" min="1970" max="<%= anioMaximo %>" required>
              <label for="anio" class="<%= old.anio ? 'active' : '' %>">Año de lanzamiento</label>
            </div>
          </div>

          <div class="row">
            <div class="col s12 m6">
              <p><i class="material-icons tiny amber-text text-darken-2" style="vertical-align: middle;">star</i> Puntuación: <span id="calif-valor"><%= old.calificacion || 5 %></span>/10</p>
              <p class="range-field">
                <input type="range" name="calificacion" id="calificacion" min="1" max="10" value="<%= old.calificacion || 5 %>" oninput="document.getElementById('calif-valor').innerText = this.value">
              </p>
            </div>
          </div>

          <div class="right-align">
            <button type="submit" class="waves-effect waves-light btn btn-accent">
              <i class="material-icons left">emoji_events</i>Agregar al catálogo
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Tabla para listar los registros -->
    <h6 class="section-title" style="margin-top: 30px;">Videojuegos registrados</h6>

    <% if (games.length === 0) { %>
      <div class="card reveal">
        <div class="empty-state">
          <i class="material-icons">videogame_asset_off</i>
          <p>Aún no hay videojuegos registrados. Usa el formulario para agregar el primero.</p>
        </div>
      </div>
    <% } else { %>
      <div class="reveal" style="overflow-x: auto;">
        <table class="striped responsive-table highlight">
          <thead>
            <tr>
              <th>Título</th>
              <th>Género</th>
              <th>Plataforma</th>
              <th>Año</th>
              <th>Desarrollador</th>
              <th>Puntuación</th>
            </tr>
          </thead>
          <tbody>
            <% games.forEach(g => {
              const score = parseFloat(g.calificacion);
              const scoreClass = score >= 8 ? 'score-high' : (score >= 5 ? 'score-mid' : 'score-low');
            %>
              <tr>
                <td>
                  <img class="game-thumb" src="<%= g.imagen %>" alt="<%= g.titulo %>" onerror="this.style.display='none';">
                  <strong><%= g.titulo %></strong>
                </td>
                <td><span class="chip chip-accent"><%= g.genero %></span></td>
                <td>
                  <span class="chip platform-chip platform-<%= g.plataforma.replace(' ', '-') %>">
                    <%= g.plataforma %>
                  </span>
                </td>
                <td><%= g.anio %></td>
                <td><%= g.desarrollador %></td>
                <td>
                  <span class="score-badge <%= scoreClass %>"><%= g.calificacion %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
</body>
</html>
