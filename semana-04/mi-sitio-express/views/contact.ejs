<!DOCTYPE html>
<html lang="es">
<head>
  <title>Contacto</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container" style="margin-top: 40px; max-width: 700px;">
    <div class="card reveal">
      <div class="card-content">
        <span class="card-title center-align" style="display:block;">
          <i class="material-icons left accent-text">mail</i>Formulario de Contacto
        </span>

        <form action="/contact" method="POST">
          <div class="input-field">
            <i class="material-icons prefix">person</i>
            <input id="nombre" type="text" name="nombre" required>
            <label for="nombre">Nombre</label>
          </div>

          <div class="input-field">
            <i class="material-icons prefix">email</i>
            <input id="email" type="email" name="email" required>
            <label for="email">Correo electrónico</label>
          </div>

          <div class="input-field">
            <i class="material-icons prefix">message</i>
            <textarea id="mensaje" class="materialize-textarea" name="mensaje" required></textarea>
            <label for="mensaje">Mensaje</label>
          </div>

          <div class="center-align">
            <button type="submit" class="waves-effect waves-light btn-large btn-accent">
              <i class="material-icons left">send</i>Enviar
            </button>
            <a href="/" class="waves-effect waves-light btn-large grey">
              <i class="material-icons left">arrow_back</i>Volver
            </a>
          </div>
        </form>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
</body>
</html>
