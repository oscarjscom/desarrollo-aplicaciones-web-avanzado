<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <noscript><p style="padding:24px">Esta aplicación necesita JavaScript activado.</p></noscript>
  <script type="module">
    // Punto de entrada: con sesión va al panel que corresponde a su rol; sin sesión, a iniciar sesión.
    import { getSession, homeFor } from '/js/session.js';
    const session = getSession();
    location.replace(session ? homeFor(session) : '/signIn');
  </script>
</body>
</html>
