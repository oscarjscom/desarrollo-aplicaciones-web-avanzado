<!DOCTYPE html>
<html lang="es">
<head>
  <title><%= siteName %> · Publicaciones</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar', { active: 'posts' }) %>

  <main class="wrap page" id="contenido">
    <h1 class="page-title">
      Publicaciones<span class="count-pill" aria-label="<%= posts.length %> publicaciones"><%= posts.length %></span>
    </h1>

    <% if (posts.length === 0) { %>
      <div class="empty">
        <i class="material-icons" aria-hidden="true">forum</i>
        <h3>Aún no hay publicaciones</h3>
        <p>Crea la primera con el botón "Nuevo post".</p>
        <a href="/posts/new" class="lx-btn lx-btn--primary"><i class="material-icons" aria-hidden="true">edit</i>Nuevo post</a>
      </div>
    <% } else { %>
      <div class="toolbar-row">
        <div class="search" role="search">
          <i class="material-icons" aria-hidden="true">search</i>
          <input type="search" id="search" class="browser-default lx-input"
                 placeholder="Buscar por título, autor o hashtag" aria-label="Buscar publicaciones" autocomplete="off">
        </div>
        <a href="/posts/new" class="lx-btn lx-btn--primary"><i class="material-icons" aria-hidden="true">add</i>Nuevo post</a>
      </div>

      <div class="feed" id="feed">
        <% posts.forEach((post, i) => { %>
          <%- include('partials/postCard', { post, actions: true, index: i }) %>
        <% }) %>
      </div>

      <div class="empty" id="no-results" role="status" hidden>
        <i class="material-icons" aria-hidden="true">search_off</i>
        <h3>Sin resultados</h3>
        <p>Ninguna publicación coincide con tu búsqueda.</p>
      </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>

  <script>
    // Filtra las tarjetas mientras se escribe en el buscador
    (function () {
      var input = document.getElementById("search");
      if (!input) return;
      var cards = document.querySelectorAll("#feed .post-card");
      var empty = document.getElementById("no-results");
      input.addEventListener("input", function () {
        var query = input.value.trim().toLowerCase();
        var visible = 0;
        cards.forEach(function (card) {
          var match = card.dataset.search.indexOf(query) !== -1;
          card.style.display = match ? "" : "none";
          if (match) visible++;
        });
        empty.hidden = visible !== 0;
      });
    })();
  </script>
</body>
</html>
