# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth (Google Cloud Console > Credenciales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (GitHub > Settings > Developer settings > OAuth Apps)
GITHUB_ID=
GITHUB_SECRET=

# Base de datos de los usuarios con correo y contraseña (Supabase, Session pooler).
# El parámetro schema=auth13 guarda la tabla en un esquema propio.
DATABASE_URL="postgresql://postgres.<ID-DEL-PROYECTO>:[TU-CONTRASEÑA]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?schema=auth13&connection_limit=1"
